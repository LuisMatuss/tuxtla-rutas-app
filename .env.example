# ==============================================================================
# Proyecto: Tuxtla-Rutas
# Plantilla Segura de Variables de Entorno (Zero-Trust)
# Copia este archivo a .env y define tus credenciales reales
# ==============================================================================

# Configuración del Servidor y Entorno
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=tuxtla_admin
DB_PASSWORD=CHANGE_ME_CRYPTO_HEX
DB_NAME=tuxtla_rutas_db

# Seguridad de Plataforma n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_CRYPTO_HEX

# Integración con Bot de Mensajería (Telegram)
TELEGRAM_BOT_TOKEN=CHANGE_ME_CRYPTO_HEX

# Configuración de CORS
CORS_ORIGIN=http://localhost:5173
